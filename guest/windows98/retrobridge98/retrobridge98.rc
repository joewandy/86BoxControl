#include <windows.h>
#include "resource.h"

IDD_TEXT_PROMPT DIALOG DISCARDABLE 0, 0, 260, 105
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RetroBridge98"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_PROMPT_MESSAGE, 7, 7, 246, 34
    EDITTEXT        IDC_PROMPT_EDIT, 7, 45, 246, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 148, 80, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 80, 50, 14
END

IDD_FAVORITES DIALOG DISCARDABLE 0, 0, 330, 190
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manage Favorites"
FONT 8, "MS Sans Serif"
BEGIN
    LISTBOX         IDC_FAVORITES_LIST, 7, 7, 238, 155,
                    LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    DEFPUSHBUTTON   "Open", IDC_FAVORITE_OPEN, 253, 7, 70, 14
    PUSHBUTTON      "Rename...", IDC_FAVORITE_RENAME, 253, 27, 70, 14
    PUSHBUTTON      "Delete", IDC_FAVORITE_DELETE, 253, 47, 70, 14
    PUSHBUTTON      "Move Up", IDC_FAVORITE_UP, 253, 75, 70, 14
    PUSHBUTTON      "Move Down", IDC_FAVORITE_DOWN, 253, 95, 70, 14
    PUSHBUTTON      "Close", IDCANCEL, 253, 148, 70, 14
END

IDD_DOWNLOAD_HISTORY DIALOG DISCARDABLE 0, 0, 360, 190
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Download History"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Downloads stay in the host inbox and are never opened automatically.",
                    -1, 7, 7, 346, 10
    LISTBOX         IDC_DOWNLOAD_LIST, 7, 22, 346, 137,
                    WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON      "Refresh", IDC_DOWNLOAD_REFRESH, 246, 168, 50, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 303, 168, 50, 14
END
